# Copy this file to .env.production-single with mode 0600. Never commit the real file.
# scripts/init_single_node_production.sh generates a complete HS256 configuration.

AUTOML_PUBLIC_HOST=automl.internal.example.com
AUTOML_HTTPS_BIND_ADDRESS=0.0.0.0
AUTOML_HTTPS_PORT=8443
# Optional: set both values and add compose.dual-ip.yaml for a second exact bind.
AUTOML_SECONDARY_PUBLIC_HOST=
AUTOML_SECONDARY_HTTPS_BIND_ADDRESS=

# Use three independent random values of at least 32 bytes each.
AUTOML_JWT_ISSUER=https://automl.internal.example.com/identity
AUTOML_JWT_AUDIENCE=managed-automl-api
AUTOML_JWT_KID=single-node-1
AUTOML_JWT_SECRET=
AUTOML_CURSOR_SECRET=
AUTOML_TICKET_SECRET=

# Host directories are deliberately explicit so backup data and the private CA
# are visible to the operator. Do not place them on a shared filesystem.
AUTOML_STATE_HOST_DIR=./.automl-production/state
AUTOML_BACKUP_HOST_DIR=./.automl-production/backups
AUTOML_CADDY_DATA_HOST_DIR=./.automl-production/caddy-data
AUTOML_CADDY_CONFIG_HOST_DIR=./.automl-production/caddy-config
AUTOML_BACKUP_RETENTION_COUNT=14
AUTOML_BACKUP_INTERVAL_SECONDS=86400
AUTOML_BACKUP_RETRY_SECONDS=300

# Optional production OIDC overlay (compose.oidc.yaml). The initializer generates
# every secret below. Give only the client id/secret and public token URL to the
# Agent platform; never distribute the admin or database credentials.
AUTOML_OIDC_PUBLIC_HOST=automl.internal.example.com
AUTOML_OIDC_HTTPS_BIND_ADDRESS=0.0.0.0
AUTOML_OIDC_HTTPS_PORT=9443
AUTOML_OIDC_REALM=automl
AUTOML_OIDC_AGENT_CLIENT_ID=automl-agent-platform
AUTOML_OIDC_AGENT_CLIENT_SECRET=
AUTOML_OIDC_AGENT_TENANT_ID=partner_a
AUTOML_OIDC_ADMIN_USERNAME=automl-admin
AUTOML_OIDC_ADMIN_PASSWORD=
AUTOML_OIDC_DB_NAME=keycloak
AUTOML_OIDC_DB_USER=keycloak
AUTOML_OIDC_DB_PASSWORD=
AUTOML_OIDC_DB_HOST_DIR=./.automl-production/identity-db
AUTOML_OIDC_BACKUP_RETENTION_DAYS=14
AUTOML_KEYCLOAK_BASE_IMAGE=quay.nju.edu.cn/keycloak/keycloak:26.3.3@sha256:6a7217a100bd3e5de4063a27a538ef999a3c5a88c4b4ec0ffc0a642aee7b2597
AUTOML_KEYCLOAK_IMAGE=managed-automl-identity:26.3.3
AUTOML_POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:17-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
AUTOML_OIDC_CPU_LIMIT=2.0
AUTOML_OIDC_MEMORY_LIMIT=2g
AUTOML_OIDC_PIDS_LIMIT=512
AUTOML_OIDC_DB_CPU_LIMIT=1.0
AUTOML_OIDC_DB_MEMORY_LIMIT=1g
AUTOML_OIDC_DB_PIDS_LIMIT=256

# China-accessible defaults. Pin images by digest in the deployment lock file.
AUTOML_PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
AUTOML_CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
AUTOML_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
AUTOML_TORCH_FIND_LINKS=https://download.pytorch.org/whl/cpu/torch/
AUTOML_TORCH_VERSION=2.13.0+cpu
AUTOML_PIP_TRUSTED_HOST=
AUTOML_IMAGE=managed-automl-api:0.8.0-production

# Request, tenant, and execution limits. Tune these from measured workloads.
AUTOML_GATEWAY_MAX_BODY_BYTES=115343360
AUTOML_GATEWAY_PIDS_LIMIT=512
AUTOML_RATE_LIMIT_REQUESTS_PER_MINUTE=600
AUTOML_RATE_LIMIT_MAX_BUCKETS=4096
AUTOML_MAX_CONCURRENT_REQUESTS=32
AUTOML_MAX_SSE_CONNECTIONS=16
AUTOML_MAX_SSE_CONNECTIONS_PER_TENANT=4
AUTOML_MAX_DATASET_BYTES=104857600
AUTOML_MAX_UPLOAD_PART_BYTES=104857600
AUTOML_MAX_ACTIVE_RUNS_PER_TENANT=2
AUTOML_MAX_STORAGE_BYTES_PER_TENANT=1073741824
AUTOML_MAX_TRIALS_PER_RUN=20
AUTOML_MAX_WALL_TIME_SECONDS=3600
AUTOML_MAX_COMPUTE_CREDITS=20
AUTOML_CPU_LIMIT=8.0
AUTOML_MEMORY_LIMIT=16g
AUTOML_PIDS_LIMIT=1024
AUTOML_SHM_SIZE=1g
AUTOML_BACKUP_CPU_LIMIT=1.0
AUTOML_BACKUP_MEMORY_LIMIT=512m
AUTOML_ML_THREADS=1
AUTOML_AUTOGLUON_TIME_LIMIT_SECONDS=300
AUTOML_LOG_LEVEL=info

# TabPFN remains disabled until the operator has accepted its license and has
# provisioned approved weights. For GPU add compose.gpu.yaml to every command.
AUTOML_TABPFN_DEVICE=cpu
AUTOML_TABPFN_LICENSE_ACCEPTED=false
AUTOML_TABPFN_MODEL_SOURCE=auto
AUTOML_TABPFN_MODEL_PATH=
AUTOML_TABPFN_CLASSIFIER_MODEL_PATH=
AUTOML_TABPFN_REGRESSOR_MODEL_PATH=
TABPFN_TOKEN=
